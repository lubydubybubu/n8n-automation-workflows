        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.content, allowed_mentions: { parse: [] } }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "4fd90936-9e5e-4658-9ba5-09774c99c6c4",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
