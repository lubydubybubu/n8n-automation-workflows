# Copy to .env and `chmod 600 .env`. Never commit .env.

# Required. Encrypts credentials stored in the n8n database.
# Generate once:  openssl rand -hex 32
# Back it up somewhere safe: without it, stored credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=

# Interface to publish port 5678 on. Default loopback (use an SSH tunnel).
# Set to the host's LAN address to reach n8n from the LAN. Never 0.0.0.0.
N8N_BIND_IP=127.0.0.1

# Optional. Discord channel webhook used by all three workflows.
# Empty = workflows run in dry-run mode and send nothing.
N8N_DISCORD_WEBHOOK_URL=
